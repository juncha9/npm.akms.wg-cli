{
    "name": "@akms/wg-cli",
    "version": "0.0.1",
    "description": "Operator CLI for a WireGuard admin VPN — issue, list, show and revoke peers from a menu or subcommands, with the server config itself as the ledger.",
    "keywords": [
        "wireguard",
        "vpn",
        "cli",
        "peer"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/juncha9/npm.akms.wg-cli.git"
    },
    "homepage": "https://github.com/juncha9/npm.akms.wg-cli#readme",
    "bugs": {
        "url": "https://github.com/juncha9/npm.akms.wg-cli/issues"
    },
    "type": "module",
    "main": "./lib/index.cjs",
    "module": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "bin": {
        "akwg": "lib/cli.js",
        "akms-wg": "lib/cli.js"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            },
            "require": {
                "types": "./lib/index.d.cts",
                "default": "./lib/index.cjs"
            }
        }
    },
    "files": [
        "lib",
        "README.md",
        "LICENSE.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc --noEmit && rimraf ./lib && tsup",
        "watch": "tsc --noEmit && tsup --watch",
        "dev": "tsx ./src/cli.ts",
        "start": "node ./lib/cli.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "dayjs": "^1.11.23",
        "ink": "^8.0.0",
        "qrcode-terminal": "^0.12.0",
        "react": "^19.3.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/qrcode-terminal": "^0.12.2",
        "@types/react": "^19.3.0",
        "@vitest/coverage-v8": "^4.1.4",
        "rimraf": "^6.1.3",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vitest": "^4.1.4"
    }
}
